{
  "openapi": "3.0.3",
  "info": {
    "title": "API do Librando",
    "description": "Documentação da API REST para o projeto Librando.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000/api",
      "description": "Servidor de Desenvolvimento Local"
    }
  ],
  "paths": {
    "/perfil": {
      "get": {
        "summary": "Ver perfil autenticado",
        "description": "Retorna os dados do utilizador atualmente autenticado.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil retornado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sucesso": { "type": "boolean", "example": true },
                    "perfil": {
                      "$ref": "#/components/schemas/Perfil"
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Não autorizado" }
        }
      },
      "post": {
        "summary": "Atualizar perfil",
        "description": "Atualiza os dados de texto e/ou imagens (foto de perfil e capa) do utilizador.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string", "maxLength": 100 },
                  "nome_usuario": { "type": "string", "maxLength": 50 },
                  "localizacao": { "type": "string", "maxLength": 100 },
                  "bio": { "type": "string", "maxLength": 300 },
                  "foto_perfil": { "type": "string", "format": "binary" },
                  "foto_capa": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sucesso": { "type": "boolean", "example": true },
                    "mensagem": { "type": "string", "example": "Perfil atualizado com sucesso!" },
                    "perfil": { "$ref": "#/components/schemas/Perfil" }
                  }
                }
              }
            }
          },
          "400": { "description": "Dados inválidos" },
          "401": { "description": "Não autorizado" }
        }
      }
    },
    "/posts": {
      "get": {
        "summary": "Listar publicações do feed",
        "description": "Retorna uma lista paginada com as publicações mais recentes e os dados dos respetivos autores.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de posts obtida com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sucesso": { "type": "boolean", "example": true },
                    "posts": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Post" }
                    },
                    "pagina_atual": { "type": "integer", "example": 1 },
                    "ultima_pagina": { "type": "integer", "example": 1 }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Criar nova publicação",
        "description": "Cria um novo post no feed (texto, imagem, gif, vídeo ou enquete).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["tipo"],
                "properties": {
                  "tipo": {
                    "type": "string",
                    "enum": ["texto", "imagem", "gif", "video", "enquete"]
                  },
                  "conteudo": { "type": "string" },
                  "midia": { "type": "string", "format": "binary" },
                  "opcoes": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Obrigatório se o tipo for enquete (2 a 4 opções)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Publicação realizada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sucesso": { "type": "boolean", "example": true },
                    "mensagem": { "type": "string", "example": "Publicação realizada com sucesso!" },
                    "post": { "$ref": "#/components/schemas/Post" }
                  }
                }
              }
            }
          },
          "400": { "description": "Erro de validação" },
          "401": { "description": "Não autorizado" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum Token"
      }
    },
    "schemas": {
      "Perfil": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "nome": { "type": "string", "example": "Henrique" },
          "nome_usuario": { "type": "string", "example": "henrique" },
          "localizacao": { "type": "string", "example": "São Paulo, SP" },
          "bio": { "type": "string", "example": "Estudante de desenvolvimento." },
          "foto_perfil_url": { "type": "string", "nullable": true, "example": "http://localhost:8000/storage/perfis/foto.jpg" },
          "foto_capa_url": { "type": "string", "nullable": true, "example": "http://localhost:8000/storage/capas/capa.jpg" }
        }
      },
      "UsuarioPost": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "nome": { "type": "string", "example": "Henrique" },
          "nome_usuario": { "type": "string", "example": "henrique" },
          "foto_perfil_url": { "type": "string", "nullable": true, "example": "http://localhost:8000/storage/perfis/foto.jpg" }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 10 },
          "tipo": { "type": "string", "example": "texto" },
          "conteudo": { "type": "string", "example": "meu cachorro é bonito" },
          "midia_url": { "type": "string", "nullable": true, "example": null },
          "opcoes": {
            "type": "array",
            "items": { "type": "object" },
            "example": []
          },
          "usuario": {
            "$ref": "#/components/schemas/UsuarioPost"
          },
          "criado_em": { "type": "string", "format": "date-time", "example": "2026-10-17T21:40:00.000000Z" }
        }
      }
    }
  }
}
